# Postgres connection string (Neon via Vercel Marketplace, Supabase, or any Postgres).
# Use the *pooled* connection string on Vercel.
DATABASE_URL="postgres://user:password@host/dbname?sslmode=require"

# 32+ random characters. Generate with: openssl rand -base64 32
AUTH_SECRET="change-me"

# Vercel Blob read/write token (created automatically when you add a Blob store to the project).
BLOB_READ_WRITE_TOKEN=""

# First administrator, created by `npm run db:seed`. They are asked to change the password on first sign-in.
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_NAME="System Administrator"
SEED_ADMIN_PASSWORD="ChangeMe-2026"
